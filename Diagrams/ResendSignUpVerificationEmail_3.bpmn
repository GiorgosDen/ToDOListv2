    <bpmn:textAnnotation id="TextAnnotation_1rnwoho">
      <bpmn:text>Check if unverified account with this email exists</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0r2blgn">
      <bpmn:text>Use Nodemailer. Creates an authentication token that expires in 15 minutes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jvb0ce">
      <bpmn:text>Also, a 201 Status message is sent to the client</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0op0mln">
      <bpmn:text>The email is sent by Brevo SMTP server</bpmn:text>
    </bpmn:textAnnotation>
