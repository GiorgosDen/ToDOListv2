    <bpmn:textAnnotation id="TextAnnotation_1rvhod8">
      <bpmn:text>The user presses the link "Already registered but didn't verify? [Resend verification email]", in the Sign Up page</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0yjjioj">
      <bpmn:text>The user imports their account email in popup form, and press the "Resend Verification" button</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1lpqmu3" sourceRef="Activity_0fh6d88" targetRef="TextAnnotation_1rvhod8" />
    <bpmn:association id="Association_1x6zykn" sourceRef="Activity_1rs8zej" targetRef="TextAnnotation_0yjjioj" />
    <bpmn:textAnnotation id="TextAnnotation_10rs3n8">
      <bpmn:text>A POST request with the imported email is sent by Axios</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0vd00v6" sourceRef="Activity_0jfpax2" targetRef="TextAnnotation_10rs3n8" />
    <bpmn:textAnnotation id="TextAnnotation_0xc1qop">
      <bpmn:text>An response with status code, redirects the user at loginpage</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_15dk0kp" sourceRef="Activity_1i24le2" targetRef="TextAnnotation_0xc1qop" />
    <bpmn:association id="Association_0dn6npz" sourceRef="TextAnnotation_0xc1qop" targetRef="Activity_1669750" />
    <bpmn:textAnnotation id="TextAnnotation_1jgoaaa">
      <bpmn:text>The user can find a new verification email, in their inbox</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_03bv278" sourceRef="Event_1segbx9" targetRef="TextAnnotation_1jgoaaa" />
    <bpmn:textAnnotation id="TextAnnotation_0ncivu2">
      <bpmn:text>An error stops the "Resend Sign Up Verification" process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1npa6nq" sourceRef="Event_07682lo" targetRef="TextAnnotation_0ncivu2" />
  </bpmn:process>
